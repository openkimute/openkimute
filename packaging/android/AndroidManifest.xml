<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app (packaging/android/build.sh): the game is libopenkumite.so in a NativeActivity
     (OpenKumiteActivity.java: the pickers for the game data, immersive full screen). Landscape, full screen (the
     screen kept on: android.rs); configuration changes (a pad or keyboard connected, a rotation) do not restart it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.openkumite"
    android:versionCode="2" android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <!-- online play -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application android:label="OpenKumite" android:icon="@mipmap/icon"
        android:extractNativeLibs="true" android:isGame="true" android:appCategory="game"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity android:name=".OpenKumiteActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="openkumite" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
